{
  "compilerOptions": {
    "allowJs": false,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["src/*"]
    },
    "strict": true,
    "types": ["vite/client", "vitest/globals"]
  },
  "include": ["**/*"],
  "exclude": ["dist", "node_modules", "playwright-report", "test-results"]
}
