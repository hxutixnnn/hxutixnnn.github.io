{
  "name": "tien-os-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Tien OS — an original, static personal-OS portfolio.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "22.23.1",
    "pnpm": "11.10.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "pnpm validate:catalog && pnpm validate:assets && astro build && node scripts/finalize-sitemap.mjs && pnpm check:output",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "astro sync && eslint .",
    "typecheck": "astro check",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:lighthouse": "lhci autorun",
    "sync:repositories": "node scripts/sync-repositories.mjs",
    "validate:catalog": "node scripts/validate-apps.mjs",
    "validate:assets": "node scripts/check-asset-provenance.mjs",
    "check:output": "node scripts/check-static-output.mjs",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm validate:catalog && pnpm validate:assets && pnpm test"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.5",
    "@astrojs/react": "6.0.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@base-ui/react": "1.6.0",
    "astro": "7.1.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-rnd": "10.5.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "serve": "14.2.6",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
