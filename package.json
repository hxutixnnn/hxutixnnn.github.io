{
  "name": "tien-os-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "tienOS — an original web desktop.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "22.23.1",
    "pnpm": "11.10.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "pnpm validate:assets && vite build && pnpm check:output",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:lighthouse": "lhci autorun",
    "validate:assets": "node scripts/check-asset-provenance.mjs",
    "validate:css": "node scripts/check-component-css.mjs",
    "check:output": "node scripts/check-static-output.mjs",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm validate:assets && pnpm validate:css && pnpm test"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "react-rnd": "10.5.3",
    "zod": "4.4.3",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "serve": "14.2.6",
    "sharp": "0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "^8.2.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
