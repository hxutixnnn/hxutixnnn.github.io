---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { pagePath, postPath, SITE } from "@/content/routes";
import DocumentLayout from "@/layouts/DocumentLayout.astro";

type Entry = CollectionEntry<"pages"> | CollectionEntry<"posts">;
interface Props {
  entry: Entry;
  kind: "page" | "post";
}

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  const posts = await getCollection("posts");
  return [
    ...pages.map((entry) => ({
      params: { slug: pagePath(entry).slice(1) },
      props: { entry, kind: "page" as const },
    })),
    ...posts.map((entry) => ({
      params: { slug: postPath(entry).slice(1) },
      props: { entry, kind: "post" as const },
    })),
  ];
}

const { entry, kind } = Astro.props;
const { Content } = await render(entry);
const pageAppRoutes: Record<string, string> = {
  "/about": "/apps/about/",
  "/works": "/apps/projects/",
  "/uses": "/apps/uses/",
  "/resources": "/apps/resources/",
  "/til": "/apps/til/",
};
const isPost = kind === "post";
const date = isPost ? (entry as CollectionEntry<"posts">).data.date : undefined;
const tags = isPost ? (entry as CollectionEntry<"posts">).data.tags : [];
const description =
  "description" in entry.data && entry.data.description ? entry.data.description : SITE.description;
const path = isPost
  ? postPath(entry as CollectionEntry<"posts">)
  : pagePath(entry as CollectionEntry<"pages">);
---

<DocumentLayout
  title={entry.data.title}
  description={description}
  date={date}
  tags={tags}
  osRoute={isPost ? "/apps/blog/" : pageAppRoutes[path]}
>
  <Content />
</DocumentLayout>
