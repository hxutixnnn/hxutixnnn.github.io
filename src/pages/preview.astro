---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PreviewGallery from "@/os/preview/PreviewGallery";
import PreviewInteractions from "@/os/preview/PreviewInteractions";
---

<BaseLayout
  title="UI Components — Tien OS preview"
  description="A static, interactive visual checkpoint for the Tien OS UI component system."
  noindex
  pageClass="preview-page-shell"
>
  <PreviewGallery />
  <section class="preview-live-checkpoint" aria-labelledby="live-checkpoint-title">
    <header class="preview-section__heading">
      <span class="preview-section__index">07</span>
      <div>
        <h2 id="live-checkpoint-title">Interaction lab</h2>
        <p>
          Static HTML is the review baseline. These three compact islands make the important behaviors real
          without coupling the preview to the production session.
        </p>
      </div>
    </header>
    <div class="preview-live-grid">
      <PreviewInteractions mode="controls" client:load />
      <PreviewInteractions mode="system" client:load />
      <PreviewInteractions mode="window" client:load />
    </div>
  </section>
</BaseLayout>

<script>
  const gallery = document.querySelector<HTMLElement>(".preview-page");

  if (gallery) {
    let theme: "dark" | "light" = "dark";
    const appearanceToggle = gallery.querySelector<HTMLButtonElement>(".preview-appearance-toggle");

    const applyTheme = () => {
      gallery.dataset.previewTheme = theme;
      gallery.classList.toggle("preview-page--dark", theme === "dark");
      gallery.classList.toggle("preview-page--light", theme === "light");
      document.body.dataset.previewTheme = theme;
      if (!appearanceToggle) return;
      const nextTheme = theme === "dark" ? "light" : "dark";
      appearanceToggle.setAttribute("aria-label", `Switch to ${nextTheme} preview appearance`);
      appearanceToggle.innerHTML = `<span aria-hidden="true">${theme === "dark" ? "☼" : "◐"}</span> ${nextTheme === "light" ? "Light" : "Dark"} appearance`;
    };

    applyTheme();
    appearanceToggle?.addEventListener("click", () => {
      theme = theme === "dark" ? "light" : "dark";
      applyTheme();
    });

    const controls = gallery.querySelector<HTMLElement>("#controls");
    const segmentButtons = controls?.querySelectorAll<HTMLButtonElement>(
      '[role="group"][aria-label="Filter sample"] button',
    );
    segmentButtons?.forEach((button) => {
      button.addEventListener("click", () => {
        segmentButtons.forEach((candidate) => {
          const selected = candidate === button;
          candidate.setAttribute("aria-pressed", String(selected));
          candidate.classList.toggle("is-active", selected);
        });
      });
    });

    const tabs = Array.from(
      controls?.querySelectorAll<HTMLButtonElement>('[role="tablist"][aria-label="Preview content tabs"] [role="tab"]') ?? [],
    );
    const selectTab = (tab: HTMLButtonElement) => {
      tabs.forEach((candidate) => {
        const selected = candidate === tab;
        candidate.setAttribute("aria-selected", String(selected));
        candidate.tabIndex = selected ? 0 : -1;
        candidate.classList.toggle("is-active", selected);
        const panelId = candidate.getAttribute("aria-controls");
        const panel = panelId ? document.getElementById(panelId) : null;
        if (panel) panel.hidden = !selected;
      });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectTab(tab));
      tab.addEventListener("keydown", (event) => {
        let nextIndex: number | undefined;
        if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === "Home") nextIndex = 0;
        if (event.key === "End") nextIndex = tabs.length - 1;
        if (nextIndex === undefined) return;
        event.preventDefault();
        const nextTab = tabs[nextIndex];
        if (!nextTab) return;
        selectTab(nextTab);
        nextTab.focus();
      });
    });

    const filter = controls?.querySelector<HTMLInputElement>('input[type="search"][placeholder="Search components"]');
    const filterList = controls?.querySelector<HTMLElement>(".preview-subgrid--feedback .preview-list");
    const filterItems = Array.from(filterList?.querySelectorAll<HTMLElement>("li") ?? []);
    const emptyMessage = document.createElement("p");
    emptyMessage.className = "preview-muted";
    emptyMessage.hidden = true;
    filterList?.after(emptyMessage);
    filter?.addEventListener("input", () => {
      const query = filter.value.toLowerCase();
      let visible = 0;
      filterItems.forEach((item) => {
        const matches = item.textContent?.toLowerCase().includes(query) ?? false;
        item.hidden = !matches;
        if (matches) visible += 1;
      });
      emptyMessage.hidden = visible > 0;
      emptyMessage.textContent = `No components match “${filter.value}”.`;
    });
  }
</script>
