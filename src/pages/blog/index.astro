---
import { getCollection } from "astro:content";
import { displayDate, postPath } from "@/content/routes";
import DocumentLayout from "@/layouts/DocumentLayout.astro";

const posts = (await getCollection("posts")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<DocumentLayout
  title="Blog"
  description="Engineering notes and practical fixes by Tien Nguyen."
  osRoute="/apps/blog/"
>
  <p>Problems, fixes, and lessons kept as durable static documents.</p>
  <ol class="document-post-list">
    {
      posts.map((post) => (
        <li>
          <time datetime={post.data.date.toISOString()}>{displayDate(post.data.date)}</time>
          <h2>
            <a href={`${postPath(post)}/`}>{post.data.title}</a>
          </h2>
          {post.data.tags.length > 0 && <p>{post.data.tags.join(" · ")}</p>}
        </li>
      ))
    }
  </ol>
</DocumentLayout>
