---
import { getCollection } from "astro:content";
import { slugify } from "@/content/routes";
import DocumentLayout from "@/layouts/DocumentLayout.astro";

const posts = await getCollection("posts");
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b));
---

<DocumentLayout title="Tags" description="Topics in Tien Nguyen's engineering notes." osRoute="/apps/blog/">
  <ul class="tag-index">
    {
      tags.map((tag) => (
        <li>
          <>
            <a href={`/tags/${slugify(tag)}/`}>{tag}</a>
            <span>{posts.filter((post) => post.data.tags.includes(tag)).length}</span>
          </>
        </li>
      ))
    }
  </ul>
</DocumentLayout>
