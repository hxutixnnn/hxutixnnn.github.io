---
import { getCollection } from "astro:content";
import { displayDate, postPath, slugify } from "@/content/routes";
import DocumentLayout from "@/layouts/DocumentLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag: slugify(tag) },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---

<DocumentLayout title={`Tagged “${tag}”`} description={`Posts tagged ${tag}.`} osRoute="/apps/blog/">
  <ol class="document-post-list">
    {
      posts.map((post) => (
        <li>
          <>
            <time datetime={post.data.date.toISOString()}>{displayDate(post.data.date)}</time>
            <h2>
              <a href={`${postPath(post)}/`}>{post.data.title}</a>
            </h2>
          </>
        </li>
      ))
    }
  </ol>
</DocumentLayout>
