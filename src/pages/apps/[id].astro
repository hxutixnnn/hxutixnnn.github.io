---
import { appCatalogue } from "@/apps/catalog";
import type { AppDescriptor } from "@/apps/contract";
import StaticAppDetail from "@/components/StaticAppDetail.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PortfolioShell from "@/os/shell/PortfolioShell";

export function getStaticPaths() {
  return appCatalogue.map((app) => ({ params: { id: app.id }, props: { app } }));
}

interface Props {
  app: AppDescriptor;
}
const { app } = Astro.props;
const shell = app.target?.kind === "core" || app.target?.kind === "embedded";
---

<BaseLayout
  title={`${app.name} — Tien OS`}
  description={app.summary}
  pageClass={shell ? "shell-page" : "app-detail-page"}
>
  <StaticAppDetail app={app} hideWhenHydrated={shell} />
  {shell && <PortfolioShell initialAppId={app.id} client:only="react" />}
</BaseLayout>
