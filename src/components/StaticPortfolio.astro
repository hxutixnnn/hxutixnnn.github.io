---
import { coreCatalogue, projectCatalogue, socialCatalogue } from "@/apps/catalog";
import { postSummaries } from "@/content/portfolio";
---

<div class="static-fallback">
  <a class="skip-link" href="#static-content">Skip desktop and view portfolio content</a>
  <header class="fallback-header glass-surface">
    <a class="site-brand" href="/"><span aria-hidden="true">T</span><strong>Tien OS</strong></a>
    <nav aria-label="Document navigation">
      <a href="/about/">About</a><a href="/works/">Works</a><a href="/blog/">Blog</a><a href="/uses/">Uses</a>
    </nav>
  </header>
  <main id="static-content" class="fallback-main">
    <section class="fallback-hero">
      <p class="eyebrow">TIEN / PERSONAL SYSTEM</p>
      <h1>Ideas, work, and notes in one useful place.</h1>
      <p>
        I’m Tien, a software engineer who builds apps, writes down practical fixes, and keeps learning in
        public.
      </p>
      <div><a class="primary-link" href="/about/">About me</a><a href="/resume.pdf">Read my résumé</a></div>
    </section>
    <section aria-labelledby="sections-title">
      <header class="section-heading"><span>01</span><h2 id="sections-title">Explore the system</h2></header>
      <ul class="fallback-apps">
        {
          coreCatalogue.map((app) => (
            <li>
              <a href={app.route}>
                <>
                  <strong>{app.name}</strong>
                  <span>{app.summary}</span>
                </>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
    <section aria-labelledby="projects-title">
      <header class="section-heading">
        <span>02</span><h2 id="projects-title">Independent projects</h2>
      </header>
      <ul class="fallback-projects">
        {
          projectCatalogue.map((app) => (
            <li>
              <a href={app.route}>
                <>
                  <strong>{app.name}</strong>
                  <span>{app.summary}</span>
                </>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
    <section aria-labelledby="social-title">
      <header class="section-heading"><span>03</span><h2 id="social-title">Social profiles</h2></header>
      <ul class="fallback-projects">
        {
          socialCatalogue.map((app) => (
            <li>
              <a href={app.route}>
                <>
                  <strong>{app.name}</strong>
                  <span>{app.summary}</span>
                </>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
    <section aria-labelledby="writing-title">
      <header class="section-heading"><span>04</span><h2 id="writing-title">Recent writing</h2></header>
      <ol class="fallback-posts">
        {
          postSummaries.slice(0, 3).map((post) => (
            <li>
              <>
                <time datetime={post.date}>{post.date}</time>
                <a href={post.path}>{post.title}</a>
              </>
            </li>
          ))
        }
      </ol>
      <a href="/blog/">All posts →</a>
    </section>
  </main>
  <footer class="site-footer">
    <p>Tien OS is an independent personal project and is not affiliated with Apple Inc.</p><a href="/rss.xml"
      >RSS</a
    >
  </footer>
</div>
